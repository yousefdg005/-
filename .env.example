# انسخ هذا الملف إلى .env ثم عدّل القيم:  cp .env.example .env

# مفتاح جلسات Flask — ولّد واحداً قوياً بالأمر:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_secret_key_here

# رابط قاعدة بيانات PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/dbname

# مفتاح المصادقة بين منصة qwqw وهذا التطبيق (تستخدمه qwqw في Heder Authorization)
INGEST_API_KEY=your_chosen_secure_token

# كلمات المرور الأولية لإنشاء الحسابات عند أول تشغيل لـ setup_db.py
# لن يعمل setup_db.py بدونهما — لا توجد كلمات مرور افتراضية
# والحسابات الموجودة مسبقاً لا تُمس عند إعادة التشغيل
ADMIN_INITIAL_PASSWORD=choose_a_strong_admin_password
READER_INITIAL_PASSWORD=choose_a_strong_reader_password

# (اختياري) مفتاح Google AI Studio (Gemini) أو OpenRouter الاحتياطي — الأفضل ضبطه من لوحة الأدمن
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# اضبطها true في الإنتاج خلف HTTPS (مثل Render) — واتركها false للتشغيل المحلي عبر HTTP
SESSION_COOKIE_SECURE=false
